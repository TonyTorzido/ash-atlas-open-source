@deploymentStatus {
	method GET HEAD
	path_regexp deploymentStatus ^/deployment-status/[0-9a-f]{64}\.json$
}
log_skip @deploymentStatus
handle @deploymentStatus {
	uri strip_prefix /deployment-status
	root * /var/lib/ash-atlas-deployment-status
	header {
		Cache-Control "no-store, max-age=0"
		Content-Type "application/json"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	file_server
}

handle /deployment-status/* {
	respond 404
}
