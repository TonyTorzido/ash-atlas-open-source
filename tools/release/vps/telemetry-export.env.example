TELEMETRY_EXPORT_ENABLED=true
TELEMETRY_EXPORT_DATABASE_URL=postgresql://ash_atlas_telemetry_export@127.0.0.1/ash_atlas_game
TELEMETRY_OPERATOR_DATABASE_URL=postgresql://ash_atlas_telemetry_ops@127.0.0.1/ash_atlas_game
TELEMETRY_EXPORT_PSEUDONYM_SALT=load-from-root-readable-secret-storage
TELEMETRY_EXPORT_PSEUDONYM_KEY_ID=closed-test-v1
TELEMETRY_EXPORTER_VERSION=closed-test-telemetry-export-v2
TELEMETRY_EXPORT_FORMAT=duckdb
TELEMETRY_EXPORT_ROOT=/var/lib/ash-atlas/telemetry-exports
TELEMETRY_ACK_ROOT=/var/lib/ash-atlas/telemetry-acknowledgments
TELEMETRY_PULL_USER=ash-telemetry-pull
TELEMETRY_COMPLETED_SEGMENT_LIMIT=5
TELEMETRY_HARD_MAX_AGE_SECONDS=604800
TELEMETRY_ACK_GRACE_SECONDS=600
TELEMETRY_EMERGENCY_BYTE_CAP=0
