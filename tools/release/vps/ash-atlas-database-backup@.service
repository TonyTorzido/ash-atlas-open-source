[Unit]
Description=Create a verified %i Ash Atlas PostgreSQL backup on the OVH backup disk
After=postgresql.service
RequiresMountsFor=/mnt/ash-atlas-backups
ConditionPathIsMountPoint=/mnt/ash-atlas-backups

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/ash-atlas/database-backup.env
ExecStart=/usr/bin/env ASH_ATLAS_DATABASE_BACKUP_CLASS=%i /opt/ash-atlas/current/tools/release/vps/create-database-backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/ash-atlas-backups /run/lock
