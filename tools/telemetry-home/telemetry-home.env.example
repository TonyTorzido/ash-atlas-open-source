TELEMETRY_VPS_HOST=game.example.invalid
TELEMETRY_VPS_USER=ash-telemetry-pull
TELEMETRY_SSH_KEY=/etc/ash-atlas/telemetry-pull-ed25519
TELEMETRY_KNOWN_HOSTS=/etc/ash-atlas/telemetry-known-hosts
TELEMETRY_HOME_STORAGE_ROOT=/var/lib/ash-atlas/home-backup-intake
TELEMETRY_HOME_STORAGE_MOUNT=/
TELEMETRY_HOME_STORAGE_UUID=replace-with-linux-filesystem-uuid
TELEMETRY_HOME_STORAGE_SERIAL=replace-with-linux-device-serial
TELEMETRY_HOME_STORAGE_FSTYPE=ext4
TELEMETRY_SEAGATE_MOUNT=/mnt/seagate-telemetry
TELEMETRY_SEAGATE_UUID=replace-with-filesystem-uuid
TELEMETRY_SEAGATE_SERIAL=replace-with-device-serial
TELEMETRY_SEAGATE_FSTYPE=ntfs3
TELEMETRY_ARCHIVE_OWNER=root:root
TELEMETRY_HOME_MINIMUM_FREE_BYTES=107374182400
# Fixed decimal-byte aggregate cap for NVMe backup intake.  It covers dump
# files, manifests/receipts, emergency copies, and every staging/partial tree.
# Installers must never increase this cap automatically.
TELEMETRY_HOME_BACKUP_CAP_BYTES=50000000000
TELEMETRY_HOME_BACKUP_WARNING_BYTES=40000000000
TELEMETRY_HOME_BACKUP_ROOT_RESERVE_BYTES=107374182400
# Projected home-filesystem usage must remain strictly below this guard after
# the largest in-flight write.  Keep it below the independent HA 80% guard.
TELEMETRY_HOME_BACKUP_ROOT_MAX_USED_PERCENT=75
TELEMETRY_HOME_BACKUP_MAX_INFLIGHT_BYTES=2147483648
TELEMETRY_HOME_BACKUP_MAX_CONCURRENT=1
TELEMETRY_HOME_EMERGENCY_KEEP=2
TELEMETRY_HOME_TELEMETRY_CAP_BYTES=10000000000
TELEMETRY_HOME_TELEMETRY_WARNING_BYTES=8000000000
# Remote manifest and dump streams are byte-limited before they enter intake.
TELEMETRY_BACKUP_MANIFEST_MAX_BYTES=1048576
# Portable archive uses physical free space plus this reserve.  A zero
# aggregate cap means no artificial portable size ceiling; physical capacity
# remains mandatory and the archive never falls back to the root mount.
TELEMETRY_PORTABLE_BACKUP_ROOT=/mnt/seagate-telemetry/ash-atlas-backup-archive
TELEMETRY_PORTABLE_BACKUP_CAP_BYTES=0
TELEMETRY_PORTABLE_BACKUP_MINIMUM_FREE_BYTES=10737418240
TELEMETRY_PORTABLE_BACKUP_ROOT_RESERVE_BYTES=0
TELEMETRY_PORTABLE_BACKUP_RETENTION_HOURLY=24
TELEMETRY_PORTABLE_BACKUP_RETENTION_DAILY=14
TELEMETRY_PORTABLE_BACKUP_RETENTION_WEEKLY=8
TELEMETRY_PORTABLE_BACKUP_RETENTION_MONTHLY=12
TELEMETRY_PORTABLE_TELEMETRY_CAP_BYTES=10000000000
TELEMETRY_PORTABLE_TELEMETRY_WARNING_BYTES=8000000000
TELEMETRY_SEAGATE_MINIMUM_FREE_BYTES=10737418240
# Restore prerequisite uses one fully preallocated, non-expanding 32 GiB
# loop-backed ext4 workspace.  The estimate is native database growth, not
# compressed dump size; increase only through a reviewed environment change.
TELEMETRY_RESTORE_WORKSPACE_CAP_BYTES=34359738368
TELEMETRY_RESTORE_WORKSPACE_BYTES=34359738368
TELEMETRY_RESTORE_DATABASE_ESTIMATE_BYTES=21474836480
TELEMETRY_RESTORE_MINIMUM_FREE_BYTES=21474836480
TELEMETRY_RESTORE_ROOT_RESERVE_BYTES=107374182400
ASH_ATLAS_RESET_BACKUP_REMOTE_DIRECTORY=/var/lib/ash-atlas/home-backup-intake/ash-atlas-reset-backups
ASH_ATLAS_RESET_BACKUP_RETENTION_COUNT=0
ASH_ATLAS_DATABASE_BACKUP_REMOTE_DIRECTORY=/var/lib/ash-atlas/home-backup-intake/ash-atlas-database-backups
TELEMETRY_BUG_REPORT_INDEX_ENABLED=true
TELEMETRY_BUG_REPORT_INDEX_ROOT=/var/lib/ash-atlas/home-backup-intake/ash-atlas-telemetry/bug-report-index
