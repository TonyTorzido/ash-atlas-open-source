[Unit]
Description=Mirror verified Ash Atlas backups from internal intake to Seagate
After=ash-atlas-telemetry-pull.service
RequiresMountsFor=__STORAGE_ROOT__
ConditionPathIsMountPoint=__SEAGATE_MOUNT__

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/ash-atlas/telemetry-home.env
ExecStart=/usr/local/sbin/ash-atlas-backup-mirror
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/run/lock
