  "doors": [
    { "id": "mouth_to_fork", "from": { "room": "cave_mouth", "anchor": "door_n" }, "to": { "room": "the_fork", "anchor": "door_s" }, "label": "Go North", "reverseLabel": "Go South" },
    { "id": "fork_to_den", "from": { "room": "the_fork", "anchor": "door_w" }, "to": { "room": "raptor_den", "anchor": "door_e" }, "label": "Go West", "reverseLabel": "Go East" },
    { "id": "fork_to_grotto", "from": { "room": "the_fork", "anchor": "door_e" }, "to": { "room": "mushroom_grotto", "anchor": "door_w" }, "label": "Go East", "reverseLabel": "Go West" },
    { "id": "fork_to_pass", "from": { "room": "the_fork", "anchor": "door_n" }, "to": { "room": "narrow_pass", "anchor": "door_w" }, "label": "Go North", "reverseLabel": "Go South" },
    { "id": "pass_to_pit", "from": { "room": "narrow_pass", "anchor": "door_e" }, "to": { "room": "bone_pit", "anchor": "door_w" }, "label": "Go East", "reverseLabel": "Go West" },
    { "id": "pit_to_throne", "from": { "room": "bone_pit", "anchor": "door_n" }, "to": { "room": "chieftain_throne", "anchor": "door_s" }, "label": "Climb the ramp", "reverseLabel": "Go Back Down" }
  ],
  "encounters": [
    {
      "id": "fork_pack", "name": "Raptor Pack", "room": "the_fork", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [{ "archetype": "wolf", "at": [{ "x": 420, "y": 440 }, { "x": 580, "y": 440 }, { "x": 420, "y": 580 }, { "x": 580, "y": 580 }] }] }],
      "boundary": "fork_boundary", "leash": "fork_leash"
    },
    {
      "id": "den_runts", "name": "Raptor Runts", "room": "raptor_den", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [{ "archetype": "dune_tick", "at": [{ "x": 200, "y": 260 }, { "x": 190, "y": 420 }, { "x": 260, "y": 560 }] }, { "archetype": "wolf", "at": [{ "x": 320, "y": 400 }] }] }],
      "boundary": "den_boundary", "leash": "den_leash"
    },
    {
      "id": "grotto_miners", "name": "Goblin Miners", "room": "mushroom_grotto", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [{ "archetype": "goblin", "at": [{ "x": 700, "y": 300 }, { "x": 700, "y": 520 }, { "x": 560, "y": 700 }] }, { "archetype": "dune_tick", "at": [{ "x": 500, "y": 250 }, { "x": 820, "y": 700 }] }] }],
      "boundary": "grotto_boundary", "leash": "grotto_leash"
    },
    {
      "id": "pass_bats", "name": "Bridge Ambush", "room": "narrow_pass", "startOn": "room_enter", "lockDoors": true,
      "waves": [
        { "mobs": [{ "archetype": "dune_tick", "at": [{ "x": 780, "y": 345 }, { "x": 700, "y": 345 }, { "x": 900, "y": 345 }] }] },
        { "delayMs": 1500, "mobs": [{ "archetype": "wolf", "at": [{ "x": 1300, "y": 320 }, { "x": 1300, "y": 390 }] }] }
      ],
      "boundary": "pass_boundary", "leash": "pass_leash"
    },
    {
      "id": "pit_ambush", "name": "Bone Pit Ambush", "room": "bone_pit", "startOn": "room_enter", "lockDoors": true,
      "waves": [
        { "mobs": [{ "archetype": "wolf", "at": [{ "x": 500, "y": 600 }, { "x": 780, "y": 600 }, { "x": 640, "y": 800 }] }] },
        { "delayMs": 2000, "mobs": [{ "archetype": "goblin", "at": [{ "x": 300, "y": 300 }, { "x": 950, "y": 300 }] }] }
      ],
      "boundary": "pit_boundary", "leash": "pit_leash"
    },
    {
      "id": "raptor_chieftain", "name": "Raptor Chieftain", "room": "chieftain_throne", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [{ "archetype": "wolf", "at": [{ "x": 500, "y": 500 }, { "x": 940, "y": 500 }] }] }],
      "boss": { "template": "dungeon_ogre", "name": "Raptor Chieftain", "at": { "x": 720, "y": 330 } },
      "boundary": "throne_boundary", "leash": "throne_leash",
      "onComplete": [{ "revealChest": "throne_chest" }, { "completeDungeon": true }, { "message": "The Raptor Chieftain falls. A hoard is revealed." }]
