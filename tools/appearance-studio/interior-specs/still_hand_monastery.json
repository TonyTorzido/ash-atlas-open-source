  "doors": [
    { "id": "gate_to_courtyard", "from": { "room": "mountain_gate", "anchor": "door_n" }, "to": { "room": "training_courtyard", "anchor": "door_s" }, "label": "Climb to the Courtyard", "reverseLabel": "Back to the Gate" },
    { "id": "courtyard_to_bell_hall", "from": { "room": "training_courtyard", "anchor": "door_n" }, "to": { "room": "bell_hall", "anchor": "door_s" }, "label": "Enter the Bell Hall", "reverseLabel": "Back to the Courtyard" },
    { "id": "bell_hall_to_garden", "from": { "room": "bell_hall", "anchor": "door_e" }, "to": { "room": "still_garden", "anchor": "door_w" }, "label": "Enter the Garden", "reverseLabel": "Back to the Bell Hall" },
    { "id": "garden_to_statue_hall", "from": { "room": "still_garden", "anchor": "door_n" }, "to": { "room": "statue_hall", "anchor": "door_s" }, "label": "Enter the Hall of Statues", "reverseLabel": "Back to the Garden" },
    { "id": "statue_hall_to_sanctum", "from": { "room": "statue_hall", "anchor": "door_e" }, "to": { "room": "grandmaster_sanctum", "anchor": "door_w" }, "label": "Enter the Sanctum", "reverseLabel": "Back to the Hall of Statues" }
  ],
  "encounters": [
    {
      "id": "courtyard_training", "name": "Training Courtyard", "room": "training_courtyard", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [
        { "archetype": "training_dummy", "at": [{ "x": 330, "y": 300 }, { "x": 1070, "y": 300 }] },
        { "archetype": "initiate_monk", "at": [{ "x": 500, "y": 420 }, { "x": 700, "y": 360 }, { "x": 900, "y": 420 }] }
      ] }],
      "boundary": "courtyard_boundary", "leash": "courtyard_leash",
      "onComplete": [{ "message": "The initiates bow out. The Bell Hall opens." }]
    },
    {
      "id": "bell_hall_toll", "name": "Bell Hall", "room": "bell_hall", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [
        { "archetype": "initiate_monk", "at": [{ "x": 420, "y": 760 }, { "x": 780, "y": 760 }] },
        { "archetype": "bell_spirit", "at": [{ "x": 380, "y": 420 }, { "x": 820, "y": 420 }] }
      ] }],
      "boundary": "bell_boundary", "leash": "bell_leash",
      "onComplete": [{ "message": "The bell falls silent." }]
    },
    {
      "id": "garden_shadows", "name": "Garden of Stillness", "room": "still_garden", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [
        { "archetype": "shadow_acrobat", "at": [{ "x": 520, "y": 300 }, { "x": 820, "y": 520 }, { "x": 520, "y": 760 }] },
        { "archetype": "staff_adept", "at": [{ "x": 760, "y": 260 }, { "x": 940, "y": 760 }] }
      ] }],
      "boundary": "garden_boundary", "leash": "garden_leash",
      "onComplete": [{ "message": "The garden is still again." }]
    },
    {
      "id": "statue_guardians", "name": "Hall of Statues", "room": "statue_hall", "startOn": "room_enter", "lockDoors": true,
      "waves": [{ "mobs": [
        { "archetype": "iron_statue", "at": [{ "x": 420, "y": 150 }, { "x": 820, "y": 150 }, { "x": 1220, "y": 150 }, { "x": 620, "y": 560 }, { "x": 1020, "y": 560 }] },
        { "archetype": "shadow_acrobat", "at": [{ "x": 1300, "y": 400 }] },
        { "archetype": "bell_spirit", "at": [{ "x": 1100, "y": 380 }] }
      ] }],
      "boundary": "statue_boundary", "leash": "statue_leash",
      "onComplete": [{ "message": "The statues fall dormant. The Sanctum waits." }]
    },
    {
      "id": "grandmaster", "name": "The Grandmaster", "room": "grandmaster_sanctum", "startOn": "room_enter", "lockDoors": true,
      "boss": { "template": "grandmaster", "at": { "x": 700, "y": 600 }, "visualScale": 1 },
      "boundary": "sanctum_boundary", "leash": "sanctum_leash",
      "onComplete": [{ "revealChest": "sanctum_chest" }, { "completeDungeon": true }, { "message": "The Grandmaster bows. His offering is revealed." }]
    }
