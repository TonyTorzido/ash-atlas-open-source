        { "archetype": "orc_brute", "at": [{ "x": 410, "y": 350 }, { "x": 788, "y": 359 }, { "x": 832, "y": 787 }, { "x": 372, "y": 762 }] },
        { "archetype": "wolf", "at": [{ "x": 600, "y": 260 }, { "x": 921, "y": 562 }, { "x": 600, "y": 860 }] }
