        { "archetype": "hog", "at": [{ "x": 700, "y": 300 }, { "x": 750, "y": 600 }] },
        { "archetype": "frog", "at": [{ "x": 500, "y": 450 }, { "x": 650, "y": 700 }, { "x": 850, "y": 450 }] }
