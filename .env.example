POPULATION_TRAVEL_VISIBLE_READY_TIMEOUT_MS=15000
# Exact verified Google `sub` values, comma-separated. Empty grants nobody.
DEV_AUTHORIZED_GOOGLE_SUBJECTS=
# Exact Google subjects, also present above, allowed to read private leaderboard metrics.
DEV_PRIVATE_LEADERBOARD_GOOGLE_SUBJECTS=
TEST_ACCESS_GATE_ENABLED=true
# Comma-separated exact verified Google provider subject IDs. Never use email addresses here.
TEST_ACCESS_ADMIN_GOOGLE_SUBJECTS=
# Use an independent, high-entropy production secret. Never expose or rotate it casually.
# generate a random 32+ byte value
INITIAL_SPAWN_HMAC_KEY=
# generate a random 32+ byte value
DOG_GENETICS_HMAC_KEY=
INITIAL_SPAWN_MAX_ATTEMPTS=256

# Authentication. Production must use AUTH_RUNTIME_MODE=public, AUTH_MODE=google,
# and HTTPS origins. Public mode rejects the fake development-login route.
AUTH_RUNTIME_MODE=local
AUTH_MODE=dev
AUTH_DEV_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
APP_PUBLIC_ORIGIN=http://127.0.0.1:5270
APPLE_SIGN_IN_ENABLED=false
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_NATIVE_BUNDLE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8_BASE64=
APPLE_REFRESH_TOKEN_KEY_ID=
APPLE_REFRESH_TOKEN_ENCRYPTION_KEY_BASE64=
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5270
# Production example behind same-host Caddy: 127.0.0.1,::1
AUTH_TRUST_PROXY=
# generate a random 32+ byte value
AUTH_SESSION_TOKEN_HMAC_KEY=
# generate a random 32+ byte value
AUTH_DEVICE_TOKEN_HMAC_KEY=
# generate a random 32+ byte value
AUTH_NETWORK_HMAC_KEY=
AUTH_NETWORK_HMAC_KEY_VERSION=v1
AUTH_SESSION_ABSOLUTE_DAYS=30
AUTH_SESSION_INACTIVITY_DAYS=14
# false (default): any Google account with email_verified=true. true: exact @gmail.com only.
AUTH_REQUIRE_GMAIL=false
AUTH_LOGIN_IP_MAX=20
AUTH_LOGIN_DEVICE_MAX=10
AUTH_NEW_ACCOUNT_DEVICE_MAX=3
AUTH_NEW_ACCOUNT_NETWORK_MAX=5
# Email one-time-code sign-in (hidden while false). Production + enabled requires
# AUTH_EMAIL_SENDER=resend, a Resend API key, a real AUTH_EMAIL_FROM on a verified
# domain, and a unique AUTH_EMAIL_CODE_HMAC_KEY (32+ chars).
AUTH_EMAIL_LOGIN_ENABLED=false
# log | resend. "log" never delivers; it records that a code was issued.
AUTH_EMAIL_SENDER=log
AUTH_EMAIL_RESEND_API_KEY=
AUTH_EMAIL_FROM=Ash Atlas <no-reply@localhost>
# generate a random 32+ byte value
AUTH_EMAIL_CODE_HMAC_KEY=
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_RESEND_SECONDS=60
AUTH_EMAIL_CODE_PER_EMAIL_10MIN=3
AUTH_EMAIL_CODE_PER_EMAIL_DAY=10
# allowlist (default): only the built-in mainstream providers (Gmail, Outlook/Hotmail/Live/MSN,
# Yahoo, iCloud, AOL, GMX) plus AUTH_EMAIL_DOMAIN_ALLOWLIST, which ADDS exact domains (CSV).
# blocklist: anything except bundled disposable/relay domains + AUTH_EMAIL_DOMAIN_BLOCKLIST_EXTRA.
AUTH_EMAIL_DOMAIN_POLICY=allowlist
AUTH_EMAIL_DOMAIN_ALLOWLIST=
AUTH_EMAIL_DOMAIN_BLOCKLIST_EXTRA=
AUTH_NEW_ACCOUNT_EMAIL_DEVICE_MAX=2
AUTH_NEW_ACCOUNT_EMAIL_NETWORK_MAX=3
# Development only (ignored in production): include the code in the log sender output.
AUTH_EMAIL_DEV_LOG_CODES=false
PROFILE_LOOKUP_RATE_MAX=120
PROFILE_EDIT_RATE_MAX=10
SOCIAL_RELATIONSHIP_RATE_MAX=120
FRIEND_REQUEST_SEND_RATE_MAX=20
FRIEND_STATE_RATE_MAX=60
ENEMY_MARK_RATE_MAX=30
BLOCK_RATE_MAX=30
SOCIAL_LIST_RATE_MAX=60

# Temporary centralized market access policy and conservative beta limits.
MARKET_GLOBAL_ACCESS=true
MARKET_MAX_ACTIVE_ORDERS_PER_PLAYER=25
MARKET_MAX_OPEN_ORDERS_PER_ITEM=10
MARKET_MAX_QUANTITY_PER_ORDER=10000
MARKET_MAX_UNIT_PRICE=1000000000
MARKET_MAX_TOTAL_ORDER_VALUE=1000000000000
MARKET_REQUESTS_PER_MINUTE=120
MARKET_CANCELLATIONS_PER_MINUTE=60
MARKET_MAX_CLAIMS_PER_REQUEST=100
MARKET_MAX_SIMPLE_BUY_QUANTITY=1000
MARKET_MAX_DEPTH_LEVELS=20
MARKET_MAX_SEARCH_RESULTS=40
MARKET_QUOTE_TTL_SECONDS=15
MARKET_TRANSACTION_RETRY_LIMIT=3
AUTH_DEV_ACCOUNT_EMAIL=developer@example.com
AUTH_DEV_PLAYER_NAME=Developer

# Bounded shared chat. Production moderation transport is configured separately later.
CHAT_ENABLED=true
CHAT_MESSAGE_MAX_LENGTH=400
# Optional server-only Google Cloud Translation Basic v2 API key. Never expose this value to the browser.
CHAT_TRANSLATION_GOOGLE_API_KEY=
CHAT_TRANSLATION_TIMEOUT_MS=5000
# UTC-month source-character ceiling; may be lowered, but cannot exceed 450000 without a code change.
CHAT_TRANSLATION_MONTHLY_CHAR_CAP=450000
CHAT_HISTORY_PAGE_SIZE=50
CHAT_CATCH_UP_LIMIT=100
CHAT_RECENT_CACHE_LIMIT=100
CHAT_RECENT_CACHE_TTL_MS=300000
CHAT_RATE_BUCKET_TTL_MS=120000
CHAT_MODERATION_QUEUE_LIMIT=256
CHAT_AUTOMATED_MUTE_MAX_SECONDS=900

# Protected test-data reset handoff. The remote destination is configured on
# the home receiver; the VPS retains only a bounded temporary dump.
ASH_ATLAS_RESET_BACKUP_ACK_TIMEOUT_SECONDS=600
ASH_ATLAS_RESET_BACKUP_POLL_SECONDS=5
# Native app compatibility is platform-specific. Hard minimums default to 0.0.0/0,
# so app-version forced updates remain disabled until an owner explicitly changes them.
NATIVE_IOS_HARD_MIN_VERSION=0.0.0
NATIVE_IOS_HARD_MIN_BUILD=0
NATIVE_IOS_RECOMMENDED_MIN_VERSION=1.0.0
NATIVE_IOS_RECOMMENDED_MIN_BUILD=1
NATIVE_IOS_LATEST_VERSION=1.0.0
NATIVE_IOS_LATEST_BUILD=1
NATIVE_ANDROID_HARD_MIN_VERSION=0.0.0
NATIVE_ANDROID_HARD_MIN_BUILD=0
NATIVE_ANDROID_RECOMMENDED_MIN_VERSION=1.0.0
NATIVE_ANDROID_RECOMMENDED_MIN_BUILD=1
NATIVE_ANDROID_LATEST_VERSION=1.0.0
NATIVE_ANDROID_LATEST_BUILD=1
NATIVE_WS_MIN=3
NATIVE_WS_MAX=3

# Location trust (docs/architecture/ACCOUNT_TRUST_AND_ANTISPOOF_PLAN.md). Every GPS
# relocation fix is logged to location_reports. off logs only; shadow also marks
# impossible-speed fixes shadow_rejected; enforce refuses them.
TRUST_LOCATION_REJECT_MODE=shadow
TRUST_LOCATION_REPORT_RETENTION_DAYS=180
# Land actions (flag place/reinforce/upgrade/burn/attack, city found/convert, PvP
# engage) during a relocation hold: off skips checks; shadow allows and logs a
# signal; enforce refuses with LAND_ACTION_SETTLING.
TRUST_LAND_ACTION_MODE=shadow
# Relocations displaced less than this (after accuracy discount) set no land-action hold.
TRUST_LAND_ACTION_MIN_DISPLACEMENT_M=500
# Minimum land-action hold after a car/rail/air speed bucket.
TRUST_TRANSIT_HOLD_MINUTES=10
# Reported accuracy above this is clamped when discounting displacement.
TRUST_SETTLE_ACCURACY_M=5000
# Decaying per-account trust score (log-odds, time constant in days) and the
# shadow quarantine/warning ladder. off computes no tiers; shadow records
# shadow_tier only; enforce is reserved for wave 3 (enforcement tier stays 0) and
# production refuses it without TRUST_LADDER_ACK=true.
TRUST_QUARANTINE_MODE=shadow
TRUST_LADDER_ACK=false
TRUST_LADDER_MAX_TIER=2
TRUST_DECAY_TAU_DAYS=7
TRUST_QUARANTINE_THRESHOLD=8
TRUST_QUARANTINE_THRESHOLD_NEW=6
TRUST_WARNING_THRESHOLD=15
# A 0.5 degree region is familiar after this many interaction days, until stale.
TRUST_FAMILIAR_REGION_DAYS=10
TRUST_FAMILIAR_REGION_STALE_DAYS=90
# When true, clients that already hold location permission send passive fixes
# while the game is in the foreground: one at a random delay, uniform between
# TRUST_PASSIVE_FIX_MIN_SECONDS and TRUST_PASSIVE_FIX_MAX_SECONDS (min >= 60,
# max >= min), re-rolled after every fix. Land actions never check location. Fixes feed the trust ledger and
# speed buckets; car/rail/air speeds may set a transit hold (enforced only when
# TRUST_LAND_ACTION_MODE=enforce). They never move the avatar, and clients never
# prompt for permission for them. Passive rows are kept 30 days.
TRUST_PASSIVE_FIX_ENABLED=true
TRUST_PASSIVE_FIX_MIN_SECONDS=180
TRUST_PASSIVE_FIX_MAX_SECONDS=420
# Alt doorway protections: moving yourself is free; bringing others is earned.
# Each mode is off|shadow|enforce; shadow logs a trust signal and allows.
# TRUST_DOORWAY_MODE: master switch for the Travel Invite / Party Travel doorway
# (Settled below, plus presence: a native fix no older than
# TRUST_PRESENCE_MAX_FIX_AGE_SECONDS within TRUST_PRESENCE_RADIUS_KM of the
# host's avatar). TRUST_DOORWAY_CONFIRMED_DAYS only maintains the legacy 0884
# confirmed_days counter; nothing gates on it. Dev profiles are exempt while
# developer login is enabled.
TRUST_DOORWAY_MODE=enforce
TRUST_DOORWAY_MIN_ACCOUNT_AGE_DAYS=14
TRUST_DOORWAY_CONFIRMED_DAYS=3
TRUST_PRESENCE_RADIUS_KM=25
TRUST_PRESENCE_MAX_FIX_AGE_SECONDS=600
# After arriving by Travel Invite or Party Travel, flag burns and flag attacks on
# flags the player does not own wait TRUST_ARRIVAL_RAID_HOLD_MINUTES. PvP is not affected.
TRUST_ARRIVAL_RAID_MODE=enforce
TRUST_ARRIVAL_RAID_HOLD_MINUTES=60
# Invites and Party Travel between accounts that share a device installation are
# refused (enforce); a shared network prefix in the last 30 days only logs a signal.
TRUST_LINKED_ALT_MODE=enforce
# Settled status (docs/architecture/NATIVE_ANTISPOOF_BUILD_PLAN.md §2). These
# numbers are secret: keep them out of the wiki, patch notes, player-facing text
# and support replies. Sending a Travel Invite or leading Party Travel needs a
# Settled account (TRUST_SETTLED_GATE_MODE, off|shadow|enforce) plus a fresh
# native fix near the avatar (presence), except for the host's own destinations
# within TRUST_HOME_DESTINATION_RADIUS_KM of their Settled home. Settled is earned
# by passive native fixes within TRUST_SETTLE_RADIUS_KM of the home anchor: each
# account rolls a secret target of TRUST_SETTLE_CHECKS_MIN..MAX counted fixes on
# TRUST_SETTLE_DAYS_MIN..MAX distinct UTC days (times its difficulty), counted
# fixes at least TRUST_SETTLE_MIN_GAP_SECONDS apart, TRUST_SETTLE_MIN_DISTINCT_POSITIONS
# distinct positions, and an account at least TRUST_DOORWAY_MIN_ACCOUNT_AGE_DAYS
# old. Web fixes never count. TRUST_SETTLE_ASSURANCE_MODE: shadow counts every
# native fix (including legacy shells); enforce counts only attested or
# device-checked fixes. Accounts grandfathered by migration 0884 without earned
# days are provisionally Settled for TRUST_SETTLE_PROVISIONAL_DAYS (halved targets).
TRUST_SETTLED_GATE_MODE=enforce
TRUST_SETTLE_ASSURANCE_MODE=shadow
TRUST_SETTLE_CHECKS_MIN=22
TRUST_SETTLE_CHECKS_MAX=30
TRUST_SETTLE_DAYS_MIN=4
TRUST_SETTLE_DAYS_MAX=6
TRUST_SETTLE_RADIUS_KM=25
TRUST_SETTLE_MIN_GAP_SECONDS=170
TRUST_SETTLE_MIN_DISTINCT_POSITIONS=3
TRUST_SETTLE_PROVISIONAL_DAYS=30
TRUST_HOME_DESTINATION_RADIUS_KM=50
# Inviters/leaders younger than TRUST_YOUNG_INVITER_DAYS: arrivals they bring wait
# TRUST_YOUNG_INVITER_ARRIVAL_HOLD_MINUTES (instead of TRUST_ARRIVAL_RAID_HOLD_MINUTES)
# before burning or attacking flags.
TRUST_YOUNG_INVITER_DAYS=30
TRUST_YOUNG_INVITER_ARRIVAL_HOLD_MINUTES=1440
# Relocation alert zones (population grid, apps/server/data/population-grid-v1.*).
# TRUST_ALERT_ZONE_MODE off|shadow|enforce: red (uninhabited) relocations are
# refused in enforce (cooldown not used, pending admin alert) and allowed with an
# alert + signal in shadow; orange (sparse) and yellow (another account's flags
# within TRUST_KINGDOM_ALERT_RADIUS_KM, any cell; extra difficulty non-urban only)
# alert and make Settled harder in both modes. A Settled account's red attempt in
# enforce pauses its Settled status until an admin approves the alert.
# TRUST_KINGDOM_PROXIMITY_RED_KM: relocating this close to another account's kingdom
# seat/territory files a severity-4 alert + kingdom_proximity (no lock); 0 = off.
# TRUST_RISK_SIGNAL_WEIGHTS overrides single defaults (kingdom_proximity=3,
# territory_proximity=1, account_shared=3, state_hopping=4), "rule=weight,...".
# Thresholds and weights are secret: never in player-facing text.
# TRUST_RED_ZONE_LOCK_MAX_AGE_DAYS: in enforce, a red relocation by an account
# younger than this many days that was never Settled suspends the account
# (unlock from the alert inbox); 0 = refuse only, never lock.
TRUST_ALERT_ZONE_MODE=enforce
TRUST_RED_ZONE_LOCK_MAX_AGE_DAYS=7
TRUST_KINGDOM_ALERT_RADIUS_KM=10
TRUST_KINGDOM_PROXIMITY_RED_KM=3
TRUST_RISK_SIGNAL_WEIGHTS=
# Phone-only relocation, off|shadow|enforce: enforce refuses relocation from the
# web client; shadow records a 0-weight signal and allows.
TRUST_RELOCATION_NATIVE_ONLY_MODE=shadow
# Hostile-action gate, off|shadow|enforce: in enforce an account that is not
# Settled cannot hit players, burn/attack others' flags or give hostile military
# orders, and nobody can hit it (two-way shield). Shadow records signals only.
TRUST_HOSTILE_GATE_MODE=shadow
# Anchored destinations, off|shadow|enforce: in enforce other players may travel
# to a flag, city or Kingdom Seat only when its owner is Settled with a Settled
# home within TRUST_HOME_DESTINATION_RADIUS_KM, and unsettled accounts keep their
# flags and structures private. Shadow records a 0-weight signal only.
TRUST_ANCHOR_MODE=shadow
# Mass-arrival alert: this many distinct accounts brought in by one host within
# 60 minutes, far from their homes, files an admin alert.
TRUST_MASS_ARRIVAL_COUNT=3
# Store-review accounts (Apple App Review, Play pre-launch): comma-separated account
# ids that count as Settled, are never red-zone locked or refused, and whose trust
# signals (mock, attestation, mismatch) are recorded at weight 0 and never revoke.
TRUST_REVIEW_ACCOUNT_IDS=
# Device environment + integrity signals (emulator, root/jailbreak, debugger, sideload,
# VPN, SIM/network/cell/time-zone country vs GPS, GNSS zero satellites, accounts per
# install, DeviceCheck spoof bit, Play Integrity device activity / app access).
# off|shadow|enforce: shadow records every signal at weight 0; enforce applies the
# config defaults (DEFAULT_TRUST_ENVIRONMENT_SIGNAL_WEIGHTS) overridden by
# TRUST_ENVIRONMENT_SIGNAL_WEIGHTS ("rule=weight,..."). Also gates multi-accounting
# (install_multi_account at TRUST_INSTALL_ALT_ACCOUNT_THRESHOLD accounts per install or
# login device) and account sharing (account_shared: TRUST_ACCOUNT_SHARED_DEVICES native
# installs, or another device faster than TRUST_ACCOUNT_SHARED_MAX_KMH within the window).
TRUST_ENVIRONMENT_SIGNALS_MODE=shadow
TRUST_ENVIRONMENT_SIGNAL_WEIGHTS=
TRUST_INSTALL_ALT_ACCOUNT_THRESHOLD=2
TRUST_ACCOUNT_SHARED_DEVICES=2
TRUST_ACCOUNT_SHARED_WINDOW_MINUTES=120
TRUST_ACCOUNT_SHARED_MAX_KMH=900
TRUST_GNSS_ZERO_SAT_MAX_ACCURACY_M=50
# Set Apple DeviceCheck bit0 on the device when an account is locked for spoofing.
TRUST_DEVICECHECK_BIT_SET_ENABLED=false
# Mismatch signals (IP vs GPS, carrier country, timezone, static GPS), off|shadow|enforce.
# shadow records signals only; enforce also revokes Settled after 3 hard mismatches in
# 24 h (fixed-line IP > 500 km from GPS, or carrier country). Needs the DB-IP Lite files
# for the IP signals (docs/ops/IPGEO_DATABASES.md); without them IP signals are skipped.
TRUST_MISMATCH_MODE=shadow
# Enforce: mismatch-family weight within 24 h at or above this also revokes Settled.
TRUST_MISMATCH_REVOKE_WEIGHT=5
# State hopping (location history): jumps between regions this far apart, faster than
# MAX_KMH, at least MIN_HOPS within WINDOW_DAYS with a return to an earlier region.
# Runs while TRUST_MISMATCH_MODE is not off.
TRUST_STATE_HOP_REGION_KM=300
TRUST_STATE_HOP_MAX_KMH=900
TRUST_STATE_HOP_MIN_HOPS=2
TRUST_STATE_HOP_WINDOW_DAYS=7
# Directory with dbip-city-lite.mmdb and dbip-asn-lite.mmdb. Default apps/server/data/ipgeo;
# on the VPS use a persistent absolute path that deploys do not replace.
# TRUST_IPGEO_DIR=
# Device attestation + mock location (docs/architecture/NATIVE_ANTISPOOF_BUILD_PLAN.md §8).
# off|shadow|enforce. off: /api/trust/attest/* return 404 and the native block is
# ignored; shadow: verdicts, per-fix assurance and signals only; enforce: mock
# relocations are refused, mock passive fixes are not applied, and tamper /
# app-integrity failures and mock fixes revoke Settled.
TRUST_ATTESTATION_MODE=shadow
TRUST_MOCK_LOCATION_MODE=shadow
# Android Play Integrity (Standard API). Production requires the Cloud project number
# and at least one app signing SHA-256 (Play Console hex, colons allowed, CSV).
TRUST_PLAY_INTEGRITY_ENABLED=false
TRUST_PLAY_INTEGRITY_PACKAGE_NAME=com.ashatlas.game
TRUST_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
TRUST_PLAY_INTEGRITY_CERT_SHA256=
# Service-account JSON, base64. Empty uses Application Default Credentials.
TRUST_PLAY_INTEGRITY_CREDENTIALS_JSON_BASE64=
# iOS App Attest (primary) and DeviceCheck (only when App Attest is unsupported).
# Development keys (appattestdevelop) are refused in production.
TRUST_APP_ATTEST_ENABLED=false
TRUST_APP_ATTEST_APP_ID=ABCDE12345.com.ashatlas.game
TRUST_APP_ATTEST_ALLOW_DEVELOPMENT=false
TRUST_DEVICECHECK_ENABLED=false
TRUST_DEVICECHECK_KEY_ID=
TRUST_DEVICECHECK_PRIVATE_KEY_P8_BASE64=
TRUST_DEVICECHECK_ENVIRONMENT=production
TRUST_ATTEST_VERDICT_TTL_SECONDS=1800
TRUST_ATTEST_CHALLENGE_TTL_SECONDS=300
TRUST_ATTEST_VERIFY_TIMEOUT_MS=4000
TRUST_ATTEST_RETENTION_DAYS=90

# Real-money purchases (Glimmer packs + Atlas Pass). Everything stays off until the first
# official store release; disabled purchase routes answer 404. Secrets only via env.
PURCHASES_APPLE_ENABLED=false
PURCHASES_GOOGLE_ENABLED=false
PURCHASES_WEB_ENABLED=false
ATLAS_PASS_ENABLED=false
# off | storefront (in-app web-shop link only where plan §7.3 allows; needs SHOP_WEB_URL)
SHOP_LINKS_MODE=off
SHOP_WEB_URL=
# Grants from Apple/Google sandbox and Xsolla test payments. Test tracks only.
PURCHASES_ACCEPT_SANDBOX=false
PURCHASES_STORE_TIMEOUT_MS=8000
# Apple: numeric App Apple ID and Apple Root CA certificates (DER, base64, comma-separated).
PURCHASES_APPLE_BUNDLE_ID=com.ashatlas.game
PURCHASES_APPLE_APP_APPLE_ID=
PURCHASES_APPLE_ROOT_CERTS_BASE64=
PURCHASES_APPLE_ONLINE_CHECKS=true
# Google: androidpublisher service account JSON (base64); RTDN Pub/Sub push OIDC audience + account.
PURCHASES_GOOGLE_PACKAGE_NAME=com.ashatlas.game
PURCHASES_GOOGLE_CREDENTIALS_JSON_BASE64=
PURCHASES_GOOGLE_RTDN_AUDIENCE=
PURCHASES_GOOGLE_RTDN_SERVICE_ACCOUNT=
PURCHASES_GOOGLE_VOIDED_SWEEP_MINUTES=1440
# Xsolla Pay Station (web provider). Sandbox checkout also needs PURCHASES_ACCEPT_SANDBOX=true.
PURCHASES_XSOLLA_MERCHANT_ID=
PURCHASES_XSOLLA_PROJECT_ID=
PURCHASES_XSOLLA_API_KEY=
PURCHASES_XSOLLA_WEBHOOK_SECRET=
PURCHASES_XSOLLA_SANDBOX=true
PURCHASES_XSOLLA_RETURN_URL=
