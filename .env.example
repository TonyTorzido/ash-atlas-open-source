POPULATION_LOCALITY_MAX_FLAGS=12
POPULATION_LOCALITY_MAX_DISTINCT_ZONES=16
POPULATION_LOCALITY_INTEREST_TTL_MS=30000
# Optional PREPARE-window streaming remains off until staged rollout.
POPULATION_SOFT_TRAVEL_PREPARE_ENABLED=false
