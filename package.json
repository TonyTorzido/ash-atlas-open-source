{
  "name": "ash-atlas",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "pnpm --filter @ash-atlas/server dev",
    "dev:client": "pnpm --filter @ash-atlas/client dev",
    "appearance:studio": "pnpm --filter @ash-atlas/appearance-studio dev",
    "appearance:studio:build": "pnpm --filter @ash-atlas/appearance-studio build",
    "appearance:studio:desktop": "pnpm --filter @ash-atlas/appearance-studio desktop:package",
    "content:packs": "tsx tools/content-packs/runtimePngPacks.ts",
    "content:packs:validate": "tsx tools/content-packs/runtimePngPacks.ts validate",
    "test:appearance-studio-launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/appearance-studio/launcher.tests.ps1",
    "test:appearance-studio-update": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/appearance-studio/update-installed.tests.ps1",
    "appearance:catalog:verify": "tsx tools/appearance-studio/verify-catalog.ts",
    "dungeon:scaffold": "tsx tools/appearance-studio/scaffold-interior.ts --kind dungeon",
    "interior:scaffold": "tsx tools/appearance-studio/scaffold-interior.ts",
    "mob:scaffold": "tsx tools/mob-scaffold/cli.ts",
    "sprite:sizes": "tsx tools/sprite-size/measure.ts",
    "wiki:sync": "tsx tools/wiki/sync.ts",
    "db:migrate": "pnpm --filter @ash-atlas/server db:migrate",
    "db:reset:test": "pnpm --filter @ash-atlas/server db:reset:test",
    "auth:cleanup": "pnpm --filter @ash-atlas/server auth:cleanup",
    "build": "pnpm build:production",
    "build:production": "pnpm --filter @ash-atlas/server build && pnpm --filter @ash-atlas/client build",
    "build:native": "pnpm --filter @ash-atlas/client build:native",
    "build:ios": "pnpm build:native",
    "ios:sync": "pnpm build:native && cap sync ios",
    "ios:open": "cap open ios",
    "android:sync": "pnpm --filter @ash-atlas/client build:android && cap sync android",
    "android:open": "cap open android",
    "mobile:registry:test": "node --test tools/mobile-release/*.test.mjs",
    "mobile:registry:validate": "node tools/mobile-release/registry-remote.mjs validate --file config/mobile-release-registry.seed.json",
    "mobile:compatibility:gate": "node tools/mobile-release/server-compatibility-gate.mjs --registry config/mobile-release-registry.seed.json --protocol-min 3 --protocol-max 3",
    "build:verify": "pnpm --filter @ash-atlas/server build:verify && pnpm check:hygiene",
    "check:hygiene": "node tools/maintenance/check-repository-hygiene.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --workspace-concurrency=1 --no-bail -r --if-present test --maxWorkers=2 --minWorkers=1",
    "test:dungeons": "pnpm --filter @ash-atlas/server exec vitest run src/game/dungeon.test.ts src/game/dungeonRewards.test.ts src/game/dungeonRuntimeMigration.test.ts src/game/dungeonLifecycle.integration.test.ts src/game/dungeonRewards.integration.test.ts src/game/dungeonRepeatLedger.integration.test.ts src/game/locations/ashAtlasPortalRegistry.test.ts src/game/locations/portalTransitionCoordinator.test.ts src/realtime/handlers/portalHandler.test.ts src/realtime/handlers/dungeonHandler.test.ts src/realtime/handlers/sessionBootstrapRecovery.test.ts --no-file-parallelism --maxWorkers=1",
    "test:architecture": "node --test tools/architecture/check-import-boundaries.test.mjs && node tools/architecture/check-import-boundaries.mjs && pnpm --filter @ash-atlas/server exec vitest run src/game/populationV2OnlyArchitecture.test.ts src/game/combat/combatArchitecture.test.ts",
    "test:postgres": "node apps/server/tools/run-postgres-tests.mjs",
    "test:policy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime-policy.tests.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/test-generation.tests.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/feature-launcher-lifecycle.tests.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/world-runtime-groups.tests.ps1",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:architecture && pnpm build:production && pnpm build:verify && pnpm check:hygiene",
    "test:market:live": "pnpm --filter @ash-atlas/server market:integration",
    "test:market:property": "pnpm --filter @ash-atlas/server market:property",
    "test:market:property:matrix": "node scripts/run-market-property-matrix.mjs",
    "test:advanced-flag-launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/advanced-flag-world-api.tests.ps1",
    "test:dev-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/runtime-policy.tests.ps1",
    "test:test-generation": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/test-generation.tests.ps1",
    "test:release-flow": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/release-flow.tests.ps1",
    "test:launcher-lifecycle": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/feature-launcher-lifecycle.tests.ps1",
    "test:world-runtime-groups": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/world-runtime-groups.tests.ps1",
    "lint": "node tools/maintenance/run-lint.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/crashlytics": "8.5.2",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-app-review": "8.0.2",
    "@capawesome/capacitor-live-update": "8.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "geotiff": "^3.0.5",
    "globals": "^16.3.0",
    "h3-js": "4.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  }
}
