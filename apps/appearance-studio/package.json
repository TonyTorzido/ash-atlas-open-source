{
  "name": "@ash-atlas/appearance-studio",
  "version": "1.56.0",
  "productName": "Ash Atlas Appearance Studio",
  "description": "Ash Atlas appearance and item authoring desktop application",
  "author": "Ash Atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsx scripts/verifyDesktopCompatibility.ts && pnpm --workspace-root appearance:catalog:verify && vite build && tsc --noEmit",
    "desktop:stage": "pnpm build && tsx scripts/buildDesktop.ts --stage-only",
    "desktop:run": "electron .desktop-stage",
    "desktop:package": "pnpm build && tsx scripts/buildDesktop.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ash-atlas/player-renderer": "workspace:*",
    "@ash-atlas/shared": "workspace:*",
    "@fastify/middie": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "pixi.js": "^8.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "^20.1.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.2.0",
    "electron-winstaller": "^5.4.4",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0"
  }
}
