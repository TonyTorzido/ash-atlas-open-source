{
  "name": "@ash-atlas/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/telemetry/cli.ts src/telemetry/bugReportCli.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@ash-atlas/shared=../../packages/shared/src/index.ts --outdir=dist --sourcemap && node ../../tools/content-packs/copyRuntimePngPacks.mjs && node ../../tools/trust/copyPopulationGrid.mjs",
    "build:verify": "node --check dist/index.js",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "catalog:verify": "tsx src/db/verifyItemCatalog.ts",
    "db:reset:test": "tsx src/db/resetTestData.ts",
    "diagnostic:population-preparation": "tsx src/game/populationPreparationDiagnostic.ts",
    "diagnostic:initial-spawns": "tsx src/auth/initialSpawnDiagnostic.ts",
    "population:repair-stone-conflicts": "tsx src/game/populationStoneConflictRepair.ts",
    "population:reconcile-river-water": "tsx src/game/riverWaterPopulationReconciliation.ts",
    "benchmark:flag-construction": "tsx src/game/flagConstructionBenchmark.ts",
    "benchmark:active-runtime": "tsx src/game/activeRuntimeBenchmark.ts",
    "benchmark:player-persistence": "tsx src/game/playerPersistenceBenchmark.ts",
    "benchmark:telemetry": "tsx src/telemetry/benchmark.ts",
    "audit:flag-environments": "tsx src/game/flagEnvironmentAudit.ts",
    "report:damage-matrix-v4": "tsx src/game/combat/damageMatrixV4Report.ts",
    "cities:reconcile-settlements": "tsx src/game/citySettlementReconciliation.ts",
    "test:classes-db": "tsx src/game/classes/classDatabaseIntegration.ts",
    "test:classes-migration-db": "tsx src/game/classes/classMigrationIntegration.ts",
    "test:party-db": "tsx src/game/party/partyDatabaseIntegration.ts",
    "benchmark:party-cache": "tsx src/game/party/partyCacheBenchmark.ts",
    "test:travel-db": "vitest run src/game/travelInvites.integration.test.ts --no-file-parallelism --maxWorkers=1",
    "auth:cleanup": "tsx src/auth/cleanup.ts",
    "auth:process-deletion": "tsx src/auth/accountDeletionCli.ts",
    "trust:reverse": "tsx src/auth/trustReversalCli.ts",
    "telemetry": "tsx src/telemetry/cli.ts",
    "bug-reports": "tsx src/telemetry/bugReportCli.ts",
    "market:reconcile": "tsx src/market/reconcile.ts",
    "market:controls": "tsx src/market/controls.ts",
    "market:migrations:verify": "tsx src/market/verifyMigrations.ts",
    "market:integration": "vitest run src/game/market.integration.test.ts src/game/economyHardening.integration.test.ts --no-file-parallelism --maxWorkers=1",
    "market:property": "vitest run src/game/marketProperty.integration.test.ts src/game/economyProperty.integration.test.ts --no-file-parallelism --maxWorkers=1",
    "market:stress": "tsx src/market/stress.ts --mode stress",
    "market:soak": "tsx src/market/stress.ts --mode soak",
    "market:smoke-auth": "tsx src/market/smokeAuth.ts",
    "market:websocket-stress": "tsx src/market/websocketStress.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@ash-atlas/shared": "workspace:*",
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.0.1",
    "cbor-x": "^1.6.6",
    "fastify": "^5.4.0",
    "geo-tz": "^8.1.9",
    "google-auth-library": "^10.9.0",
    "i18n-iso-countries": "^7.14.0",
    "maxmind": "^5.0.7",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
