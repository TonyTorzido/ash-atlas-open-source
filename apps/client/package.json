{
  "name": "@ash-atlas/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --workspace-root appearance:catalog:verify && vite build",
    "build:native": "pnpm --workspace-root appearance:catalog:verify && node src/native/buildNativeSeedBundle.mjs ios && node src/native/writeNativeLiveUpdateManifest.mjs dist",
    "build:android": "pnpm --workspace-root appearance:catalog:verify && node src/native/buildNativeSeedBundle.mjs android && node src/native/writeNativeLiveUpdateManifest.mjs dist",
    "build:native:full": "pnpm --workspace-root appearance:catalog:verify && vite build --mode capacitor && node src/native/writeNativeLiveUpdateManifest.mjs dist",
    "build:android:full": "pnpm --workspace-root appearance:catalog:verify && vite build --mode capacitor-android && node src/native/writeNativeLiveUpdateManifest.mjs dist",
    "build:ios": "pnpm build:native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright-ct.config.ts",
    "test:full-app": "playwright test --config playwright-full-app.config.ts"
  },
  "dependencies": {
    "@ash-atlas/player-renderer": "workspace:*",
    "@ash-atlas/shared": "workspace:*",
    "@capacitor-firebase/crashlytics": "8.5.2",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-app-review": "8.0.2",
    "@capawesome/capacitor-live-update": "8.4.3",
    "maplibre-gl": "^5.6.0",
    "pixi.js": "^8.10.1",
    "pmtiles": "4.4.1",
    "polygon-clipping": "^0.15.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@ash-atlas/animator": "workspace:*",
    "@jsquash/oxipng": "2.3.0",
    "@playwright/experimental-ct-react": "^1.61.1",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "vite": "^7.0.4"
  }
}
