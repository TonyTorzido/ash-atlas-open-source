{
  "name": "@ash-atlas/animator",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas Animator: original 2D skeletal animation runtime (clean-room; see docs/plans/atlas-animator.md section 2).",
  "type": "module",
  "exports": {
    ".": "./src/core/index.ts",
    "./core": "./src/core/index.ts",
    "./pixi": "./src/pixi/index.ts",
    "./commands": "./src/tools/commands.ts",
    "./store": "./src/tools/documentStore.ts",
    "./diff": "./src/tools/diff.ts",
    "./atlas": "./src/tools/atlasImport.ts",
    "./patch": "./src/tools/jsonPatch.ts",
    "./tools/autoMesh": "./src/tools/autoMesh.ts",
    "./tools/outline": "./src/tools/outline.ts"
  },
  "types": "./src/core/index.ts",
  "dependencies": {
    "cdt2d": "1.0.0",
    "pixi.js": "^8.19.0",
    "pngjs": "^7.0.0",
    "zod": "^3.25.76"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/pixi && tsc --noEmit -p browser-tests && tsc --noEmit -p render-page && tsc --noEmit -p bench-page",
    "test": "vitest run",
    "test:browser": "playwright test --config browser-tests/playwright.config.ts",
    "animator": "tsx src/cli/animator.ts",
    "swag:template": "tsx src/cli/swagTemplate.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "vite": "^7.3.6"
  }
}
