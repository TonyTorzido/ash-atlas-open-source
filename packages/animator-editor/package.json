{
  "name": "@ash-atlas/animator-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas Animator editor: pose and key clips on the template rig in the browser (written from scratch).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5211 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rigsync": "node scripts/rigsync.mjs",
    "qa": "node scripts/qa-core.mjs",
    "qa:persistence": "node scripts/qa-persistence.mjs",
    "qa:data-safety": "node scripts/qa-data-safety.mjs",
    "qa:pipeline": "node scripts/qa-pipeline.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@ash-atlas/animator": "workspace:*",
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "vite": "7.3.6"
  }
}
